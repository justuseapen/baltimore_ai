<script type="application/ld+json">
<%=
  ld = {
    "@context" => "https://schema.org",
    "@graph" => [
      {
        "@type" => "Organization",
        "@id" => "#{canonical_url(root_path)}#organization",
        "name" => "Baltimore.ai",
        "url" => canonical_url(root_path),
        "description" => "A curated directory of AI companies, research labs, and resources in the Baltimore metro."
      },
      {
        "@type" => "WebSite",
        "@id" => "#{canonical_url(root_path)}#website",
        "url" => canonical_url(root_path),
        "name" => "Baltimore.ai",
        "publisher" => { "@id" => "#{canonical_url(root_path)}#organization" }
      }
    ]
  }
  raw json_escape(ld.to_json)
%>
</script>
